# Example only. Go reads process environment; export values or use Docker env_file.
APP_ENV=development
HOST=127.0.0.1
PORT=3080
CONSOLE_ORIGIN=http://127.0.0.1:3080
COOKIE_SECURE=false
DEMO_MODE=true
CONSOLE_USERNAME=admin
CONSOLE_PASSWORD_HASH_FILE=
# Compatible scrypt hash from: go run ./cmd/hash-password
# Never configure VALUE and VALUE_FILE together.
HEADSCALE_URL=
HEADSCALE_PUBLIC_URL=
HEADSCALE_API_KEY_FILE=
HEADSCALE_POLICY_MODE=unknown
SESSION_TTL_SECONDS=3600
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900
# Configuration management is opt-in; read-only by default.
HEADSCALE_CONFIG_PATH=
CONFIG_WRITE_ENABLED=false
CONFIG_TEST_EXECUTABLE=
APPLY_EXECUTABLE=
# Production requires APP_ENV=production, Secure=true and exact HTTPS origin.
# For compose, secret file paths must be outside build context:
# CONSOLE_PASSWORD_HASH_SECRET_FILE=/private/mesh/password.hash
# HEADSCALE_URL_SECRET_FILE=/private/mesh/headscale-url.secret
# HEADSCALE_API_KEY_SECRET_FILE=/private/mesh/headscale-api-key.secret
