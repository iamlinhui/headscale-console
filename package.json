{
  "name": "mesh-headscale-console",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite frontend --config frontend/vite.config.js --host 127.0.0.1 --strictPort",
    "build": "vite build frontend --config frontend/vite.config.js",
    "start": "go run .",
    "preview": "go run . preview",
    "hash-password": "go run ./cmd/hash-password",
    "test": "go test ./...",
    "test:ui": "playwright test --config tests/e2e/playwright.config.js",
    "build:server": "go build -trimpath -o build/bin/mesh-console .",
    "build:all": "pnpm build && pnpm build:server",
    "docker:check": "docker compose -f docs/headscale/docker-compose.yml config --quiet",
    "docker:build": "docker build -f deploy/docker/Dockerfile -t docker.io/promptness/headscale-console:latest .",
    "docker:pull": "docker compose -f docs/headscale/docker-compose.yml pull headscale-console",
    "docker:up": "docker compose -f docs/headscale/docker-compose.yml up -d --no-deps headscale-console"
  },
  "dependencies": {
    "vue": "^3.5.24",
    "naive-ui": "^2.43.2",
    "lucide-vue-next": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^6.4.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@playwright/test": "^1.56.1"
  },
  "packageManager": "pnpm@10.11.0"
}
